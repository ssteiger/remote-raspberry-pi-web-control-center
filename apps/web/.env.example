# Public URLs
SUPABASE_API_URL="http://127.0.0.1:54721"
SUPABASE_GRAPHQL_URL="http://127.0.0.1:54721/graphql/v1"
SUPABASE_STORAGE_URL="http://127.0.0.1:54721/storage/v1/s3"
SUPABASE_STUDIO_URL="http://127.0.0.1:54723"
INBUCKET_URL="http://127.0.0.1:54724"
SUPABASE_ANON_KEY=""

# Private configuration
SUPABASE_DB_URL="postgresql://postgres:postgres@127.0.0.1:54722/postgres"
SUPABASE_JWT_SECRET="super-secret-jwt-token-with-at-least-32-characters-long"
# Populate from `supabase status` output after running `bun run dev:db`.
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_S3_ACCESS_KEY=""
SUPABASE_S3_SECRET_KEY=""
SUPABASE_S3_REGION="local"

# Encrypts the SSH passwords and private keys of your Raspberry Pis in the
# database. Any long random string works, e.g. `openssl rand -base64 32`.
# Changing it makes the saved device credentials unreadable.
DEVICE_SECRET_KEY=""

# Optional: the local folder a deploy uploads. Defaults to raspberry-pi-script/
# at the repo root.
# RASPBERRY_PI_SCRIPT_DIR=""

# Optional language model for the assistant in the header (Cmd+J). Leave empty
# and the assistant says how to turn it on. Provider is "openai", "anthropic"
# or "cursor" (a Cursor API key from cursor.com/dashboard -> Integrations;
# CURSOR_API_KEY works too). The model defaults to gpt-4o-mini,
# claude-3-5-haiku-latest or composer-2.5 when unset.
AI_PROVIDER=""
AI_API_KEY=""
AI_MODEL=""
# Optional API root, for an OpenAI-compatible local server such as Ollama
# (http://127.0.0.1:11434/v1) or LM Studio.
AI_BASE_URL=""
